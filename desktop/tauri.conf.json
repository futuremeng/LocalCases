{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalCases",
  "version": "0.1.0",
  "identifier": "org.localcases.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LocalCases",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:5311 http://127.0.0.1:5312 http://127.0.0.1:5313; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "LICENSE",
      "NOTICE",
      "LICENSES.third-party.md"
    ],
    "copyright": "LocalCases contributors"
  }
}
